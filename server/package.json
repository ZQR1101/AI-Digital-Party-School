{
  "name": "party-school-server",
  "version": "1.0.0",
  "description": "基于AI的数智党校学习系统 - 后端服务",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "db:init": "node init-db.js",
    "db:upgrade:ai": "node upgrade-ai.js",
    "db:upgrade:papers": "node upgrade-papers.js",
    "db:upgrade:assessments": "node upgrade-assessments.js",
    "test": "node --test test/*.test.js",
    "eval:offline": "node ai-eval/run-eval.js --mode=offline --gate",
    "eval:online": "node ai-eval/run-eval.js --mode=online",
    "eval:refusal-analysis": "node ai-eval/tools/compare-refusal-strategies.js",
    "eval:compare": "node ai-eval/tools/compare-v1-v2.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "mysql2": "^3.6.0",
    "pdf-parse": "^2.4.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}