PORT=3001

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=party_school

# 生产环境务必替换为长随机串（如 openssl rand -hex 32 生成）
JWT_SECRET=replace-with-a-long-random-secret

# 数据库初始化/演示数据的初始账号口令（至少 10 位强口令，禁止使用弱口令）
# init-db.js 用 SEED_PASSWORD 生成 hash；seed-batch-data.js 用 DEMO_PASSWORD
SEED_PASSWORD=
DEMO_PASSWORD=
# 后台新建/导入用户未指定密码时使用的默认口令（至少 10 位强口令）
DEFAULT_USER_PASSWORD=

# 登录防护：同一账号连续失败达到阈值后临时锁定
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# OpenAI兼容接口；不配置时综合评价自动使用确定性中文模板
AI_API_URL=https://api.deepseek.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_TIMEOUT_MS=15000
# 工具调用架构：function=原生 Function Calling（默认）；prompt=提示词JSON模式
AI_TOOL_MODE=function

# ========== RAG 真实语义检索（阿里云百炼 DashScope / 通义千问，OpenAI 兼容）==========
# 申请 Key: https://bailian.console.aliyun.com/ → 账号管理 / API-KEY 管理（Key 形如 sk-xxx）
# 不配置 API 地址时，Embedding/Reranker 自动降级为本地关键词算法（非语义）
# 说明：百炼 Key 也可用标准环境变量 DASHSCOPE_API_KEY，代码会自动读取。
EMBEDDING_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
EMBEDDING_BATCH=10
EMBEDDING_TIMEOUT_MS=8000

# ========== Reranker 真实语义重排 ==========
# 方案一（推荐·性价比）：硅基流动 SiliconFlow，OpenAI 兼容 rerank 端点。
#   端点固定为 https://api.siliconflow.cn/v1/rerank，请求体 {model,query,documents,top_n}，
#   响应 results[].{index,relevance_score}，与本地解析逻辑直接兼容，无需改代码。
#   高性价比模型：BAAI/bge-reranker-v2-m3（中英双语，官方示例默认）
RERANKER_API_URL=https://api.siliconflow.cn/v1/rerank
RERANKER_API_KEY=
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TIMEOUT_MS=8000

# 方案二（备选）：阿里云百炼业务空间专属域名 + OpenAI 兼容 rerank 端点。
#   端点格式：https://{WorkspaceId}.{region}.maas.aliyuncs.com/compatible-api/v1/reranks
#   WorkspaceId：百炼「业务空间管理」页或创建 Key 弹窗的 API Host / 业务空间 ID（如 llm-xxxxxx）
#   region：地域 ID（cn-beijing / ap-southeast-1 / cn-hongkong / us-east-1），各地域 Key 不能混用
#   旧域名 dashscope.aliyuncs.com 仍可达，但官方注明 2026-09-30 起不再支持新特性。
# 切换方案时把上面三个 RERANKER_* 值替换为下列对应值即可：
# RERANKER_API_URL=https://llm-xxxxxx.cn-beijing.maas.aliyuncs.com/compatible-api/v1/reranks
# RERANKER_API_KEY=
# RERANKER_MODEL=qwen3.7-text-rerank

# 向量数据库（可选）：不启用则使用内置内存向量索引
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_ENABLED=false

# ========== 可观测性 ==========
# 日志级别：debug | info（默认） | warn | error；输出为单行 JSON（含 requestId/耗时/脱敏）
LOG_LEVEL=info
