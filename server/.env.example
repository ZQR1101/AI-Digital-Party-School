PORT=3001

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=party_school

JWT_SECRET=replace-with-a-long-random-secret

# OpenAI兼容接口；不配置时综合评价自动使用确定性中文模板
AI_API_URL=https://api.deepseek.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_TIMEOUT_MS=15000
# 工具调用架构：function=原生 Function Calling（默认）；prompt=提示词JSON模式
AI_TOOL_MODE=function

# ========== RAG 真实语义检索（SiliconFlow，OpenAI 兼容）==========
# 申请 Key: https://cloud.siliconflow.cn/account/ak
# 不配置以下两项时，Embedding/Reranker 自动降级为本地关键词算法（非语义）
EMBEDDING_API_URL=https://api.siliconflow.cn/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH=32
EMBEDDING_TIMEOUT_MS=8000

RERANKER_API_URL=https://api.siliconflow.cn/v1/rerank
RERANKER_API_KEY=
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TIMEOUT_MS=8000

# 向量数据库（可选）：不启用则使用内置内存向量索引
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_ENABLED=false
