      "expect": "accept",
      "expectNormalized": {
        "tool": "query_learning_statistics",
        "metric": "learning_completion_rate",
        "organizationName": "学生第一党支部",
        "timeRangeLabel": "2026年",
        "groupBy": null
      },
      "split": "heldout"
    },
