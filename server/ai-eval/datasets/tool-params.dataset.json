              }
            }
          ]
        }
      },
      "expect": "accept",
      "expectNormalized": {
        "tool": "query_exam_statistics",
        "metric": "exam_pass_rate",
        "organizationName": null,
        "timeRangeLabel": "2026年",
        "groupBy": "month"
      },
      "split": "dev"
    },
    {
      "id": "tool-006",
      "name": "JSON 代码块内容解析",
